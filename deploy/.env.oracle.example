# Oracle Cloud Credentials
export OCI_USER_OCID="ocid1.user.oc1..your-user-ocid"
export OCI_TENANCY_OCID="ocid1.tenancy.oc1..your-tenancy-ocid"
export OCI_FINGERPRINT="your:api:key:fingerprint:here"
export OCI_PRIVATE_KEY_PATH="~/.oci/oci_api_key.pem"
export OCI_REGION="ap-sydney-1"

# SSH key for VM access
export SSH_PUBLIC_KEY_PATH="~/.ssh/id_rsa.pub"
