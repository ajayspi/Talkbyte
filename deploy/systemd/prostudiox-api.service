[Unit]
Description=ProstudioX / MoneyPrinterTurbo API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/prostudiox/MoneyPrinterTurbo
Environment=PATH=/opt/prostudiox/venv/bin:/usr/local/bin:/usr/bin:/bin
# One CPU-bound worker is enough on the Ampere A1 (4 OCPU / 24 GB free tier).
# MoviePy/FFmpeg render is single-process per task; raising workers only adds
# scheduling overhead. Lower niceness so the system stays responsive.
Nice=5
ExecStart=/opt/prostudiox/venv/bin/python main.py
Restart=on-failure
RestartSec=10

# Free-tier hardening (no system limits beyond defaults needed).
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
