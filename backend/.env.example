# TalkByte Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── Telnyx ─────────────────────────────────────────────────
TELNYX_API_KEY=KEY...
TELNYX_PUBLIC_KEY=...              # for webhook signature verification
TELNYX_SIP_CONNECTION_ID=...       # SIP trunk connection ID
TELNYX_PHONE_NUMBER=+614...        # provisioned AU number (fallback)
TELNYX_MESSAGING_PROFILE_ID=...    # for outbound SMS

# ── LiveKit ─────────────────────────────────────────────────
LIVEKIT_URL=wss://your-app.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...

# ── Deepgram ────────────────────────────────────────────────
DEEPGRAM_API_KEY=...

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1              # do not change without testing

# ── ElevenLabs ──────────────────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...            # choose a natural AU-accent voice

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...           # public key (safe for client)
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # secret — backend only, never expose

# ── Upstash Redis ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=...
# Also used as Celery broker:
CELERY_BROKER_URL=rediss://:TOKEN@xxxx.upstash.io:6379

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...      # use sk_test_... in dev
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...    # for restaurant onboarding

# ── Square POS ──────────────────────────────────────────────
SQUARE_APPLICATION_ID=sq0idp-...
SQUARE_APPLICATION_SECRET=...
SQUARE_ENVIRONMENT=production      # or sandbox

# ── App ─────────────────────────────────────────────────────
ENVIRONMENT=development            # development | staging | production
SECRET_KEY=...                     # generate: openssl rand -hex 32
FRONTEND_URL=http://localhost:3000
SENTRY_DSN=                        # leave blank in dev

# ── Call session ────────────────────────────────────────────
CALL_SESSION_TTL_SECONDS=1800      # 30 minutes
PAYMENT_LINK_TTL_SECONDS=1800      # 30 minutes before Stripe link expires
