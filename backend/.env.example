# TalkByte Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...           # public key (safe for client)
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # secret — backend only, never expose

# ── Upstash Redis ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=...
# Also used as Celery broker:
CELERY_BROKER_URL=rediss://:TOKEN@xxxx.upstash.io:6379

# ── App ─────────────────────────────────────────────────────
ENVIRONMENT=development            # development | staging | production
SECRET_KEY=...                     # generate: openssl rand -hex 32
FRONTEND_URL=http://localhost:3000
SENTRY_DSN=                        # leave blank in dev

# ── Call session ────────────────────────────────────────────
CALL_SESSION_TTL_SECONDS=1800      # 30 minutes
PAYMENT_LINK_TTL_SECONDS=1800      # 30 minutes before Stripe link expires

# ── WhatsApp Business Cloud API ─────────────────────────────
# Stored in Supabase platform_secrets table (secret_name / secret_value rows).
# Set here only for local development fallback (get_platform_secret() checks
# the DB first, then falls back to os.environ).
# Obtain from Meta Business Manager -> WhatsApp -> API Setup.
WHATSAPP_PHONE_NUMBER_ID=           # e.g. 123456789012345
WHATSAPP_ACCESS_TOKEN=              # Meta System User permanent token
